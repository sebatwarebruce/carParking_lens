# ---------------------------------------------------------------------------
# Frontend environment. Every VITE_* variable is PUBLIC (shipped to browsers).
# NEVER put provider secrets, API keys, tokens or passwords here.
# ---------------------------------------------------------------------------

# Base URL of the Node/Express REST API (Blueprint section 14 uses /api/v1).
VITE_API_BASE_URL=/api/v1

# true  = use the in-browser mock backend (src/mocks) with clearly labelled demo data.
# false = talk to the real backend at VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# Mock only: simulated network latency in milliseconds.
VITE_MOCK_LATENCY_MS=350

# Display defaults (the server's /settings/policy overrides these when available).
VITE_DEFAULT_TIMEZONE=Africa/Kigali
VITE_DEFAULT_CURRENCY=RWF

# Optional public support contact shown on the Help page.
VITE_SUPPORT_CONTACT=
